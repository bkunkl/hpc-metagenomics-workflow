# =============================================================================
# kraken2_v2.17.1_bracken_v3.1_vmtouch.sif -- Kraken2 + Bracken (+ vmtouch)
#
# Used by metagenomics_wgs_pipeline.sbatch for read-level taxonomic profiling:
#   k2 classify   (Kraken2 wrapper CLI)
#   bracken       (abundance re-estimation at species level)
#
# vmtouch is bundled so the Kraken2 database can be pre-loaded into page cache
# before an array of jobs starts hammering it:
#   vmtouch -tf /path/to/k2_pluspf_20260626
#
# VERSION NOTE: the original filename says `kraken2_v2.17.1`. No public Kraken2
# release carries that number -- upstream versions are 2.1.x (2.1.3, 2.1.6...).
# The pin below assumes the intended version was 2.1.3 with the `k2` wrapper
# (added in 2.1.3), but this is a guess about the original image's contents.
# best-effort -- verify before rebuilding
#   singularity exec <old>.sif kraken2 --version
#   singularity exec <old>.sif bracken -v
# =============================================================================

Bootstrap: docker
From: mambaorg/micromamba:1.5.8

%labels
    Maintainer  hpc-metagenomics-workflow
    Kraken2     2.1.3        # best-effort -- filename said "v2.17.1"; verify
    Bracken     3.1          # from the original filename
    Provides    k2 kraken2 bracken vmtouch

%post
    set -eux
    USER=root micromamba install -y -n base -c conda-forge -c bioconda \
        kraken2=2.1.3 \
        bracken=3.1
    micromamba clean --all --yes

    apt-get update
    apt-get install -y --no-install-recommends vmtouch
    rm -rf /var/lib/apt/lists/*

%environment
    export PATH=/opt/conda/bin:$PATH
    export LC_ALL=C

%runscript
    exec "$@"

%test
    k2 --version || kraken2 --version
    bracken -v
    vmtouch -h > /dev/null && echo "vmtouch ok"
